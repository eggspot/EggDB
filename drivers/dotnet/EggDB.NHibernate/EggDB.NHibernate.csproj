<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>EggDB.NHibernate</RootNamespace>
    <Description>NHibernate's driver and dialect for EggDB's ADO.NET provider.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NHibernate" Version="5.5.2" />
    <ProjectReference Include="../EggDB.Data/EggDB.Data.csproj" />
  </ItemGroup>
</Project>
