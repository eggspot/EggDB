<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>EF1001</NoWarn>
    <RootNamespace>EggDB.EntityFrameworkCore</RootNamespace>
    <Description>Entity Framework Core's database provider for EggDB, embedded or over the network, through EggDB's ADO.NET provider.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <ProjectReference Include="../EggDB.Data/EggDB.Data.csproj" />
  </ItemGroup>
</Project>
