chapter functions-window, "Window Functions": row_number, rank and dense_rank as select-list items
rows
SELECT g, n, row_number() OVER (PARTITION BY g ORDER BY n DESC) AS r, rank() OVER (ORDER BY g), dense_rank() OVER (ORDER BY g) FROM (VALUES (1, 10), (2, 20), (1, 30)) v(g, n) ORDER BY g, n
----
g|n|r|rank|dense_rank
1|10|2|1|1
1|30|1|1|1
2|20|1|3|2
SELECT 3

rows
SELECT * FROM (SELECT n, row_number() OVER (ORDER BY n) AS position FROM (VALUES (5), (3)) v(n)) numbered WHERE position = 2
----
n|position
5|2
