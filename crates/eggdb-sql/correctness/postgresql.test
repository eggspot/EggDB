chapter infoschema-tables, "information_schema": tables, columns and constraints
ok
CREATE TABLE infoschema_parent (id integer PRIMARY KEY, code varchar(10) UNIQUE)

ok
CREATE TABLE infoschema_child (id integer PRIMARY KEY, parent_id integer REFERENCES infoschema_parent (id), amount numeric(8,2) NOT NULL)

rows
SELECT table_name, table_type FROM information_schema.tables WHERE table_name LIKE 'infoschema%' ORDER BY 1
----
table_name|table_type
infoschema_child|BASE TABLE
infoschema_parent|BASE TABLE
SELECT 2

rows
SELECT column_name, data_type, is_nullable, numeric_precision, numeric_scale FROM information_schema.columns WHERE table_name = 'infoschema_child' ORDER BY ordinal_position
----
column_name|data_type|is_nullable|numeric_precision|numeric_scale
id|integer|NO|32|0
parent_id|integer|YES|32|0
amount|numeric|NO|8|2
SELECT 3

rows
SELECT tc.constraint_name, kcu.column_name, ccu.table_name AS references_table, ccu.column_name AS references_column FROM information_schema.table_constraints tc JOIN information_schema.key_column_usage kcu ON kcu.constraint_name = tc.constraint_name AND kcu.constraint_schema = tc.constraint_schema JOIN information_schema.constraint_column_usage ccu ON ccu.constraint_name = tc.constraint_name AND ccu.constraint_schema = tc.constraint_schema WHERE tc.constraint_type = 'FOREIGN KEY' AND tc.table_name = 'infoschema_child'
----
constraint_name|column_name|references_table|references_column
infoschema_child_parent_id_fkey|parent_id|infoschema_parent|id
SELECT 1

