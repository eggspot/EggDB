json_extract_path|json_extract_path_text|json_strip_nulls
"foo"|foo|[{"f1":1},2,null,3]
SELECT 1

rows
SELECT jsonb_set('[{"f1":1,"f2":null},2,null,3]', '{0,f1}', '[2,3,4]', false), jsonb_insert('{"a": [0,1,2]}', '{a, 1}', '"new_value"'), jsonb_strip_nulls('[{"f1":1, "f2":null}, 2, null, 3]')
----
jsonb_set|jsonb_insert|jsonb_strip_nulls
[{"f1": [2, 3, 4], "f2": null}, 2, null, 3]|{"a": [0, "new_value", 1, 2]}|[{"f1": 1}, 2, null, 3]
