CREATE TABLE [dbo].[Products] ([ProductID] INT IDENTITY(1,1) NOT NULL, [Name] NVARCHAR(50) NOT NULL, [Price] DECIMAL(10,2) NOT NULL, CONSTRAINT [PK_Products] PRIMARY KEY ([ProductID]))

ok
INSERT INTO Products (Name, Price) VALUES (N'Bread', 2.50), (N'Eggs', 3.20), (N'Jam', 4.75), (N'Tea', 1.99)

rows
SELECT TOP 2 Name, Price FROM Products ORDER BY Price DESC
----
name|price
Jam|4.75
Eggs|3.20
SELECT 2

rows
SELECT TOP (1) [Name] AS [Cheapest] FROM [dbo].[Products] ORDER BY [Price]
----
cheapest
Tea
SELECT 1

rows
