CREATE TABLE Inventory315 (ProductID INT NOT NULL, LocationID INT NOT NULL, Quantity INT NOT NULL, PRIMARY KEY (ProductID, LocationID))

ok
INSERT INTO Inventory315 VALUES (1, 6, 10), (1, 7, 5), (2, 6, 3), (3, 7, 8)

ok
CREATE FUNCTION dbo.ufnGetInventoryStock315(@ProductID int)
RETURNS int
AS
BEGIN
    DECLARE @ret int;
    SELECT @ret = SUM(p.Quantity)
    FROM Inventory315 p
    WHERE p.ProductID = @ProductID
        AND p.LocationID = '6';
    IF (@ret IS NULL)
        SET @ret = 0;
    RETURN @ret;
END;

