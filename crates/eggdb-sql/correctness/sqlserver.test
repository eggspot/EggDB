CREATE PROCEDURE dbo.usp_GetSalesYTD315
    @SalesPerson nvarchar(50) = NULL,
    @SalesYTD decimal(12,2) = NULL OUTPUT
AS
    IF @SalesPerson IS NULL
    BEGIN
        PRINT 'ERROR: You must specify a last name for the sales person.'
        RETURN(1)
    END
    ELSE
    BEGIN
        IF (SELECT COUNT(*) FROM Staff315 WHERE LastName = @SalesPerson) = 0
            RETURN(2)
    END
    SELECT @SalesYTD = SalesYTD FROM Staff315 WHERE LastName = @SalesPerson;
    IF @@ERROR <> 0
    BEGIN
        RETURN(3)
    END
    ELSE
    BEGIN
        IF @SalesYTD IS NULL
            RETURN(4)
        ELSE
            RETURN(0)
    END

