chapter "MERGE (Transact-SQL)"
ok
CREATE TABLE Blogs48 ([Id] int NOT NULL IDENTITY, [Name] nvarchar(100) NOT NULL, [Url] nvarchar(max) NULL, CONSTRAINT [PK_Blogs48] PRIMARY KEY ([Id]))

rows
SET IMPLICIT_TRANSACTIONS OFF;
SET NOCOUNT ON;
MERGE [Blogs48] USING (
VALUES (N'Kitchen', N'https://example.com/kitchen', 0),
(N'Garden', NULL, 1)) AS i ([Name], [Url], _Position) ON 1=0
WHEN NOT MATCHED THEN
INSERT ([Name], [Url])
VALUES (i.[Name], i.[Url])
OUTPUT INSERTED.[Id], i._Position;
----
id|_position
1|0
2|1
MERGE 2

rows
MERGE INTO Blogs48 AS t USING (VALUES (1, N'Kitchen and Bakery'), (3, N'Attic')) AS s (id, name) ON t.Id = s.id
WHEN MATCHED THEN UPDATE SET Name = s.name
WHEN NOT MATCHED BY TARGET THEN INSERT (Name) VALUES (s.name)
OUTPUT inserted.Id, inserted.Name, deleted.Name AS old_name;
----
id|name|old_name
1|Kitchen and Bakery|Kitchen
3|Attic|NULL
MERGE 2

rows
MERGE Blogs48 USING (VALUES (2)) AS s (id) ON Blogs48.Id = s.id
WHEN MATCHED THEN DELETE
OUTPUT deleted.Id, deleted.Name;
----
id|name
2|Garden
MERGE 1

rows
MERGE Blogs48 AS t USING (VALUES (1, N'x'), (3, N'y')) AS s (id, name) ON t.Id = s.id
WHEN MATCHED AND s.name = N'y' THEN UPDATE SET Url = s.name;
SELECT Id, Name, Url FROM Blogs48 ORDER BY Id
----
id|name|url
1|Kitchen and Bakery|https://example.com/kitchen
3|Attic|y
SELECT 2

