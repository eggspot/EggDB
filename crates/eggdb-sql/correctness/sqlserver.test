ok
CREATE PROCEDURE dbo.uspGetList315 @Product varchar(40)
    , @MaxPrice decimal(10,2)
    , @ComparePrice decimal(10,2) OUTPUT
    , @ListPrice decimal(10,2) OUT
AS
    SET NOCOUNT ON;
    SELECT Name AS product, ListPrice AS list_price
    FROM Products315
    WHERE Category LIKE @Product AND ListPrice < @MaxPrice
    ORDER BY Id;
    SET @ListPrice = (SELECT MAX(ListPrice) FROM Products315 WHERE Category LIKE @Product AND ListPrice < @MaxPrice);
    SET @ComparePrice = @MaxPrice;

rows
DECLARE @ComparePrice decimal(10,2), @Cost decimal(10,2);
EXECUTE dbo.uspGetList315 '%Bikes%', 700, @ComparePrice OUT, @Cost OUTPUT
IF @Cost <= @ComparePrice
    SELECT 'These products can be purchased for less than $' + RTRIM(CAST(@ComparePrice AS varchar(20))) + '.' AS message
ELSE
    SELECT 'The prices for all products in this category exceed $' + RTRIM(CAST(@ComparePrice AS varchar(20))) + '.' AS message
----
message
These products can be purchased for less than $700.00.
SELECT 1

ok
