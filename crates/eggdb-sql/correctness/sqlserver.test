chapter "WHILE (Transact-SQL)", "BREAK (Transact-SQL)", "CONTINUE (Transact-SQL)"
rows
DECLARE @i int = 0, @odd int = 0;
WHILE @i < 10
BEGIN
    SET @i = @i + 1;
    IF @i % 2 = 0 CONTINUE;
    IF @i > 7 BREAK;
    SET @odd = @odd + @i;
END;
SELECT @i AS i, @odd AS odd_sum
----
i|odd_sum
9|16
SELECT 1

