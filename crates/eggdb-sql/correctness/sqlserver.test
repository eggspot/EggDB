CREATE FUNCTION dbo.ufn_StockByCategory315 (@category nvarchar(50))
RETURNS TABLE
AS
RETURN
(
    SELECT P.Id AS product_id, P.Name AS name, SUM(I.Quantity) AS total
    FROM Products315 AS P
    JOIN Inventory315 AS I ON I.ProductID = P.Id
    WHERE P.Category LIKE @category
    GROUP BY P.Id, P.Name
)

rows
SELECT product_id, name, total FROM dbo.ufn_StockByCategory315 (N'%Bikes') ORDER BY product_id
----
product_id|name|total
1|Road-750|15
2|Mountain-500|3
3|Touring-3000|8
SELECT 3

ok
CREATE FUNCTION dbo.ufn_Restock315 (@below int)
RETURNS @restock TABLE (product_id int PRIMARY KEY NOT NULL, name nvarchar(50) NOT NULL, on_hand int NOT NULL)
AS
BEGIN
    INSERT INTO @restock
    SELECT P.Id, P.Name, COALESCE(SUM(I.Quantity), 0)
    FROM Products315 AS P
    LEFT JOIN Inventory315 AS I ON I.ProductID = P.Id
    GROUP BY P.Id, P.Name;
    DELETE FROM @restock WHERE on_hand >= @below;
    RETURN
END

