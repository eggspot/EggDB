CREATE PROCEDURE dbo.uspGetEmployees315
    @LastName nvarchar(50),
    @FirstName nvarchar(50)
AS
    SET NOCOUNT ON;
    SELECT FirstName AS first_name, LastName AS last_name, Department AS department
    FROM Staff315
    WHERE FirstName = @FirstName AND LastName = @LastName;

