ok
CREATE TABLE merged (id NUMBER PRIMARY KEY, v NUMBER)

rows
MERGE INTO merged m USING (SELECT 1 id, 10 v FROM dual UNION ALL SELECT 2, 20 FROM dual) s ON (m.id = s.id) WHEN NOT MATCHED THEN INSERT VALUES (s.id, s.v)
----
MERGE 2

rows
MERGE INTO merged m USING (SELECT 2 id, 25 v FROM dual UNION ALL SELECT 3, 30 FROM dual) s ON (m.id = s.id) WHEN NOT MATCHED THEN INSERT (id, v) VALUES (s.id, s.v) WHEN MATCHED THEN UPDATE SET m.v = s.v
----
MERGE 2

rows
MERGE INTO merged m USING merged s ON (m.id = s.id) WHEN MATCHED THEN UPDATE SET m.v = s.v + 1
----
MERGE 3

