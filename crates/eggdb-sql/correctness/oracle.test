rows
MERGE INTO merged m USING (SELECT 1 id, 100 v FROM dual UNION ALL SELECT 1, 200 FROM dual) s ON (m.id = s.id) WHEN MATCHED THEN UPDATE SET m.v = s.v WHERE s.v > 150
----
MERGE 1

