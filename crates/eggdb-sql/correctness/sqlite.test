chapter "UPDATE" and "The ON CONFLICT Clause": UPDATE OR FAIL keeps the rows changed before the conflict, OR IGNORE skips the rows that conflict, OR REPLACE deletes the rows in the way and fills NOT NULL columns from their defaults, OR ROLLBACK ends the transaction
ok
CREATE TABLE up338 (id INTEGER PRIMARY KEY, code INTEGER UNIQUE, note TEXT NOT NULL DEFAULT 'none')

ok
INSERT INTO up338 VALUES (1, 1, 'a'), (2, 2, 'b'), (3, 3, 'c')

error 23505 2067
UPDATE OR FAIL up338 SET code = CASE id WHEN 2 THEN 3 ELSE code + 10 END

rows
SELECT id, code FROM up338 ORDER BY id
----
id|code
1|11
2|2
3|3
SELECT 3

error 23505 2067
UPDATE OR ABORT up338 SET code = CASE id WHEN 2 THEN 3 ELSE code + 10 END WHERE id < 3

rows
SELECT id, code FROM up338 ORDER BY id
----
id|code
1|11
2|2
3|3
SELECT 3

ok
UPDATE up338 SET code = id

rows
UPDATE OR IGNORE up338 SET code = code + 1
----
UPDATE 1

rows
SELECT id, code FROM up338 ORDER BY id
----
id|code
1|1
2|2
3|4
SELECT 3

rows
UPDATE OR IGNORE up338 SET note = NULL
----
UPDATE 0

rows
UPDATE OR REPLACE up338 SET code = code + 1 WHERE id < 3
----
UPDATE 1

rows
UPDATE OR REPLACE up338 SET note = NULL WHERE id = 1
----
UPDATE 1

rows
SELECT id, code, note FROM up338 ORDER BY id
----
id|code|note
1|2|none
3|4|c
SELECT 2

ok
BEGIN

ok
INSERT INTO up338 VALUES (5, 5, 'e')

error 23505 2067
UPDATE OR ROLLBACK up338 SET code = 4 WHERE id = 5

rows
SELECT id FROM up338 ORDER BY id
----
id
1
3
SELECT 2

ok
DROP TABLE up338

chapter "Built-in Aggregate Functions": group_concat(X), group_concat(X, Y) and total(X) (D376)
ok
