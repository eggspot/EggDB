rows
SELECT k, group_concat(v) AS g FROM gc376 GROUP BY k ORDER BY k
----
k|g
1|a,b
2|c
SELECT 2

rows
SELECT group_concat(v, '-') AS g, total(k) AS t FROM gc376
----
g|t
a-b-c|6.0
SELECT 1

rows
SELECT total(k) AS t FROM gc376 WHERE k > 5
----
t
0.0
SELECT 1

ok
