chapter lang_select.html, "The ORDER BY clause": NULLs are smaller than any other value, so they come first for ASC and last for DESC, with or without an index
ok
CREATE TABLE nulls340 (id INTEGER PRIMARY KEY, v INTEGER)

ok
INSERT INTO nulls340 VALUES (1, 20), (2, NULL), (3, 10)

rows
SELECT id FROM nulls340 ORDER BY v
----
id
2
3
1
SELECT 3

rows
SELECT id FROM nulls340 ORDER BY v DESC
----
id
1
3
2
SELECT 3

rows
SELECT id FROM nulls340 ORDER BY v NULLS LAST
----
id
3
1
2
SELECT 3

ok
CREATE INDEX nulls340_v ON nulls340 (v)

rows
SELECT id FROM nulls340 ORDER BY v LIMIT 2
----
id
2
3
SELECT 2

rows
SELECT id, row_number() OVER (ORDER BY v) AS rn FROM nulls340 ORDER BY id
----
id|rn
1|3
2|1
3|2
SELECT 3

ok
DROP TABLE nulls340

ok
DROP TABLE regr340

chapter lang_select.html, "The ORDER BY clause", "The LIMIT clause": ORDER BY ... LIMIT on a nullable indexed column gives NULLs first for ASC and last for DESC, also after an equality on the index's leading column and with a WHERE that excludes NULL
ok
CREATE TABLE nulls341 (id INTEGER PRIMARY KEY, kind INT, v INT)

ok
CREATE INDEX nulls341_v ON nulls341 (v)

ok
CREATE INDEX nulls341_kind_v ON nulls341 (kind, v)

ok
INSERT INTO nulls341 VALUES (1, 1, 30), (2, 1, NULL), (3, 2, 10), (4, 1, 20), (5, 2, NULL), (6, 1, 15)

rows
SELECT id FROM nulls341 ORDER BY v LIMIT 3
----
id
2
5
3
SELECT 3

rows
SELECT id FROM nulls341 ORDER BY v DESC LIMIT 4
----
id
1
4
6
3
SELECT 4

rows
SELECT id FROM nulls341 ORDER BY v DESC, id DESC LIMIT 2 OFFSET 3
----
id
3
5
SELECT 2

rows
SELECT id FROM nulls341 ORDER BY v DESC, id DESC LIMIT 2 OFFSET 4
----
id
5
2
SELECT 2

rows
SELECT id FROM nulls341 WHERE kind = 1 ORDER BY v LIMIT 2
----
id
2
6
SELECT 2

rows
SELECT id FROM nulls341 WHERE kind = 1 ORDER BY v DESC LIMIT 4
----
id
1
4
6
2
SELECT 4

rows
SELECT id FROM nulls341 WHERE v IS NOT NULL ORDER BY v LIMIT 2
----
id
3
6
SELECT 2

rows
SELECT id FROM nulls341 WHERE v > 12 ORDER BY v DESC LIMIT 5
----
id
1
4
6
SELECT 3

ok
DROP TABLE nulls341


